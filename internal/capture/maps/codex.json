{
  "tool": "codex",
  "locate": {
    "session_id": ["session_id"],
    "cwd": ["cwd"],
    "event_name": ["hook_event_name"],
    "prompt": ["prompt"],
    "model": ["model"],
    "tool_name": ["tool_name"],
    "tool_input": ["tool_input"],
    "tool_response": ["tool_response"]
  },
  "input": {
    "file_path": ["file_path", "filePath", "path", "notebook_path"],
    "command": ["command"],
    "exit_code": ["exit_code"]
  },
  "events": {
    "SessionStart": { "action": "session_meta" },
    "UserPromptSubmit": { "action": "prompt" },
    "PostToolUse": { "action": "tool_use" },
    "Stop": { "action": "session_end" }
  },
  "tools": {
    "Write": { "action": "file_touch", "op": "write" },
    "Edit": { "action": "file_touch", "op": "edit" },
    "MultiEdit": { "action": "file_touch", "op": "edit" },
    "NotebookEdit": { "action": "file_touch", "op": "edit" },
    "Bash": { "action": "command" }
  },
  "tool_fallback": { "action": "structural", "handler": "codex_apply_patch" }
}
